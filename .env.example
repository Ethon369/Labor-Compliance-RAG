# ===== 复制为 .env 后按需填写；.env 不入库 =====
#
# 使用方式：
#   本机直连（Python 脚本直接跑）：填 localhost，先 docker compose up -d postgres 启数据库
#   Docker Compose 全容器（推荐）：不改 .env——compose 会自动注入 postgres 作为 host
#   启动系统：docker compose up -d   冒烟：curl http://localhost:8000/docs
#   停止系统：docker compose down    （pgdata volume 保留，数据不丢）

# PostgreSQL
# 本机直连时用 localhost；Docker Compose 内会自动覆盖为 postgres（服务间内网）
DATABASE_URL=postgresql://labor:labor@localhost:5432/labor

# ---- embedding 提供方（阶段 2 检索用）----
# offline=确定性哈希占位向量（零 key、离线可测可演示）；siliconflow=真 bge-m3
# 换 siliconflow 前先填下面 API key；向量维度与列一致，默认 1024 已对齐 bge-m3
EMBEDDING_MODE=offline
# EMBEDDING_DIM=1024
# 硅基流动 API（bge-m3 / bge-reranker），OpenAI 兼容格式
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-m3

# ---- rerank 提供方（阶段 3 精排用）----
# offline=词元重叠占位精排（零 key、离线可测）；siliconflow=真 bge-reranker
# 与 embedding 共用同一个 SILICONFLOW_API_KEY
RERANK_MODE=offline
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RRF 融合后多少名候选送精排；池越大精排越有得选，代价是成对打分更多（延迟↑）
RERANK_POOL=30

# ---- 阶段 4 LLM（OpenAI 兼容接口：DeepSeek / 硅基流动 / 阿里云百炼均可）----
# offline=模板占位回答（零 key、离线可测可演示）；llm=真 LLM
LLM_MODE=offline
# 阿里云百炼（DashScope OpenAI 兼容）示例；换别的供应商改 BASE_URL + MODEL 即可
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 改写/回答追求可复现确定，温度放低；事实引用场景幻觉代价高
# LLM_TEMPERATURE=0.0

# ---- 认证（阶段 9）----
# 签名 token 的 HMAC 密钥：生产环境必须改成强随机值（勿用默认值）
# AUTH_SECRET=dev-secret-change-me
