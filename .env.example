# ===== 复制为 .env 后按需填写；.env 不入库 =====

# PostgreSQL（docker compose 里 postgres 服务的内网地址）
# 本机直连时用：postgresql://labor:labor@localhost:5432/labor
DATABASE_URL=postgresql://labor:labor@localhost:5432/labor

# ---- embedding 提供方（阶段 2 检索用）----
# offline=确定性哈希占位向量（零 key、离线可测可演示）；siliconflow=真 bge-m3
# 换 siliconflow 前先填下面 API key；向量维度与列一致，默认 1024 已对齐 bge-m3
EMBEDDING_MODE=offline
# EMBEDDING_DIM=1024
# 硅基流动 API（bge-m3 / bge-reranker），OpenAI 兼容格式
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-m3

# ---- 后续阶段预留 ----
# LLM（DeepSeek / Qwen，OpenAI 兼容接口）
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
