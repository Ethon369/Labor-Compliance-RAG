# 生产环境变量模板 · 劳动争议智能合规助手
#
# 使用：cp .env.production .env ，然后修改所有标【必改】的项。
# 用 deploy.sh 部署时会自动生成随机密钥填充这三项，无需手动填；这里保留空值是
# 为了配合 docker-compose.prod.yml 的 ${VAR:?} 校验——漏配会直接拒绝启动。

# ================= 数据库 =================
# 【必改】PostgreSQL 密码（容器内 labor 用户）
POSTGRES_PASSWORD=

# ================= 安全（最重要） =================
# 【必改】token 签名密钥，泄露后他人可伪造任意用户身份
#         生成方式：openssl rand -hex 32
AUTH_SECRET=

# 管理员账号：首次启动自动创建，已存在则只补 role、不覆盖已改密码
ADMIN_USERNAME=admin
# 【必改】管理员密码——绝不能是开发用的默认值
ADMIN_PASSWORD=

# ================= 检索与生成能力 =================
# offline = 零成本占位实现（确定性哈希向量 / 词元重叠精排 / 模板回答）
# siliconflow = 真 bge-m3 embedding + bge-reranker，需要 key
#
# ⚠️ 公网 demo 的成本提示：
#   保持 offline 可零 API 成本运行，但回答是模板拼的；
#   若切到真模型，任何人访问都会消耗你的额度，建议同时开启下面的限流（已在 app 内置令牌桶）。
EMBEDDING_MODE=offline
EMBEDDING_DIM=1024
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-m3

RERANK_MODE=offline
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RRF 融合后送精排的候选池大小
RERANK_POOL=30

# LLM_MODE=llm 会真调用大模型产生费用，公网 demo 建议先保持 offline
LLM_MODE=offline
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
